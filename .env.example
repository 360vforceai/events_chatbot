# Discord (Developer Portal -> Bot -> Token; right-click server -> Copy Server ID)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# OpenAI
OPENAI_API_KEY=

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Admin (any random string for scraper API routes)
ADMIN_API_KEY=

# Scraper / real-time sync (Discord bot background tasks)
SCRAPE_INTERVAL_HOURS=6
DATA_SYNC_INTERVAL_MINUTES=30
LIVE_EVENTS_CACHE_MINUTES=10
# Optional: post new getINVOLVED events to this Discord channel ID
DISCORD_UPDATES_CHANNEL_ID=
DISCORD_ANNOUNCE_NEW_EVENTS=true

# Tri-state live events (concerts, sports, comedy) — free key at https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Web (Next.js — use web/.env.local, not bot/.env)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional legacy DynamoDB vars (not used by current code)
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# AWS_REGION=us-east-1
